# Copy to .env for local Compose use. Never commit .env.
# Secret-bearing values intentionally remain empty.
DISCORD_TOKEN=
# Comma-separated server IDs. Use DISCORD_GUILD_ID instead for legacy single-server setups.
DISCORD_GUILD_IDS=123456789012345678,234567890123456789
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=123456789012345678
# Comma-separated channel IDs across the configured servers.
# The bot only answers direct mentions in these channels.
DISCORD_CHANNEL_IDS=123456789012345678
DATABASE_URL=
POSTGRES_PASSWORD=
PII_HASH_SALT=
# Optional. Enables the read-only `--agent` NEXON Open API route.
NEXON_API_KEY=
AGENT_MAX_TOOL_CALLS=4
# Public HTML tag issued for the registered NEXON application.
NEXON_ANALYTICS_SCRIPT=

LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=local-coder
LLM_TIMEOUT_SECONDS=180
MAPLE_CHAT_LLM_COMPOSE_FILE=/home/hyuns/local-claude-code/docker-compose.qwen38-27b.yml
MAPLE_CHAT_LLM_COMPOSE_SERVICE=vllm
MAPLE_CHAT_LLM_PROFILE=qwen38-27b
EMBEDDING_MODEL=BAAI/bge-m3
# Keep local for the existing offline SentenceTransformer workflow. Set remote to use DCM.
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
EMBEDDING_REMOTE_MODEL=bge-m3
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_DEVICE=cuda
INDEX_BATCH_SIZE=256
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_MODEL_COMMIT=5617a9f61b028005a4858fdac845db406aefb181
RERANKER_MODEL_COMMIT=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
# The bot role requires remote: the always-on DCM reranker container serves BGE reranking,
# and the in-process local cross-encoder is rejected at bot startup (silent CPU latency).
RERANKER_PROVIDER=remote
# Host-run development uses the published 127.0.0.1 port; inside the compose network
# use http://dcm-reranker:80/v1 (and http://dcm-embedding:80/v1 for embeddings).
RERANKER_BASE_URL=http://127.0.0.1:8082/v1
RERANKER_REMOTE_MODEL=bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=60

CRAWL_DAILY_AT=05:00
# Scan newest pages until a page contains no unseen article IDs (safety bound only).
DAILY_LATEST_MAX_SCAN_PAGES=20
# Historical continuation is fixed at one listing page per board per daily run.
# Official Nexon update-note rolling window and Thursday 05:00 KST refresh.
PATCH_NOTES_WEEKLY_AT=05:00
PATCH_NOTES_RETENTION_DAYS=365
PATCH_NOTES_MAX_LIST_PAGES=60
PATCH_NOTES_INDEX_BATCH_SIZE=32
CRAWLER_USER_AGENT='MapleChat/0.1 (private-noncommercial)'
CRAWLER_CONTACT=
LIVE_CRAWL_ENABLED=false
LIVE_CRAWL_APPROVAL_FILE=
LIVE_CRAWL_SCOPE=approved_sample
LIVE_CRAWL_BOARD_IDS=2304
LIVE_CRAWL_START_PAGE=1
LIVE_CRAWL_MAX_PAGES=1
LIVE_CRAWL_MAX_ARTICLES=5
LIVE_CRAWL_RESUME=false
LIVE_CRAWL_INCLUDE_COMMENTS=true
LIVE_CRAWL_INCLUDE_OCR=false
# Full backfill processes at most this many pages per board in one resumable invocation.
FULL_BACKFILL_TARGET_PAGE=200
FULL_BACKFILL_MAX_ARTICLES_PER_PAGE=100
FULL_BACKFILL_PAGE_BATCH=10
RUN_LIVE_SYNC_ON_START=true
RUN_DAILY_SYNC=true
RUN_WEEKLY_PATCH_SYNC=true
FIXTURE_ROOT=tests/fixtures/inven
LOG_LEVEL=INFO
